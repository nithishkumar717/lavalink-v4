# Copy this file to .env and replace both values before starting the stack.
LAVALINK_DOMAIN=lavalink.example.com
LAVALINK_SERVER_PASSWORD=replace-with-a-long-random-secret
YOUTUBE_OAUTH_REFRESH_TOKEN=replace-with-your-youtube-refresh-token

# LavaSrc provider credentials. Configure the providers you want to use.
LAVASRC_SPOTIFY_CLIENT_ID=
LAVASRC_SPOTIFY_CLIENT_SECRET=
LAVASRC_ENABLE_SPOTIFY=false
LAVASRC_APPLE_MUSIC_TOKEN=
LAVASRC_ENABLE_APPLE_MUSIC=false
LAVASRC_DEEZER_MASTER_KEY=
LAVASRC_DEEZER_ARL=
LAVASRC_ENABLE_DEEZER=false
LAVASRC_YANDEX_TOKEN=
LAVASRC_ENABLE_YANDEX=false
LAVASRC_VK_TOKEN=
LAVASRC_ENABLE_VK=false
LAVASRC_TIDAL_TOKEN=
LAVASRC_ENABLE_TIDAL=false
LAVASRC_QOBUZ_USER_TOKEN=
LAVASRC_QOBUZ_APP_ID=
LAVASRC_QOBUZ_APP_SECRET=
LAVASRC_ENABLE_QOBUZ=false
LAVASRC_JIOSAAVN_SECRET_KEY=
LAVASRC_ENABLE_JIOSAAVN=false
